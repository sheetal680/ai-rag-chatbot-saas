# Copy this file to .env.local for local development.
# On Vercel, set these in the project's Environment Variables dashboard.
# "NEXT_PUBLIC_" prefix makes variables available in the browser bundle.

# ── Backend API ───────────────────────────────────────────────────────────────
# Local:      http://localhost:8000
# Production: https://your-app.up.railway.app  (or your Render URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Client ID ─────────────────────────────────────────────────────────────────
# Used to scope RAG documents and chat sessions.
# For MVP single-tenant: use "default" or your user ID after first login.
# For multi-tenant: this will come from the JWT — no longer needed.
NEXT_PUBLIC_CLIENT_ID=default
