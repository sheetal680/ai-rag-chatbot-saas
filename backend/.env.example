# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.
#
# Generate SECRET_KEY:  python -c "import secrets; print(secrets.token_hex(32))"
# Or with OpenSSL:       openssl rand -hex 32

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="AI RAG Chatbot"
APP_VERSION="0.1.0"
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=changeme-replace-with-openssl-rand-hex-32

# Comma-separated list of allowed frontend origins (no trailing slashes)
# Development:  ALLOWED_ORIGINS=http://localhost:3000
# Production:   ALLOWED_ORIGINS=https://your-app.vercel.app,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# ── LLM Provider ─────────────────────────────────────────────────────────────
# LLM_PROVIDER: auto | groq | gemini | ollama
# "auto" picks Groq if GROQ_API_KEY is set, else Gemini, else Ollama (local dev).
LLM_PROVIDER=auto

# Groq (primary — fast, free tier available: console.groq.com)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-70b-versatile

# Google Gemini (fallback — get key at aistudio.google.com)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-flash

# Ollama (local dev only — install from ollama.ai, run: ollama pull llama3.1)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Embeddings ────────────────────────────────────────────────────────────────
# sentence-transformers runs locally — no API key needed.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Supabase / PostgreSQL ─────────────────────────────────────────────────────
# Get from: Supabase dashboard → Settings → Database → Connection string → URI
# Use the "Direct connection" URI (not the pooler) — asyncpg manages its own pool.
# Supabase requires SSL; the ?sslmode=require suffix handles this automatically.
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Local dev:      ./chroma_data
# Railway:        Railway adds a volume — set the mount path here
# Render:         /data/chroma_data  (matches render.yaml disk mountPath)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=documents

# ── Meta / WhatsApp Business API (optional — leave blank to disable) ──────────
# Docs: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# Free tier: 1,000 conversations/month. No Twilio account needed.
#
# Steps to get these values:
#   1. Create a Meta App at developers.facebook.com → Business type
#   2. Add "WhatsApp" product to the app
#   3. API Setup page → copy Phone Number ID and generate a temporary access token
#      (use a System User token for permanent access)
#   4. Webhook tab → set Callback URL to https://your-backend/api/v1/whatsapp/webhook
#      Verify token = the value you set below for META_WEBHOOK_VERIFY_TOKEN
#   5. App Settings → Basic → copy App Secret into META_APP_SECRET
META_WEBHOOK_VERIFY_TOKEN=your-secret-verify-token
META_APP_SECRET=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v19.0
